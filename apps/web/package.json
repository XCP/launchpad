{
  "name": "@xcp/launchpad-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check": "tsc --noEmit && eslint && npm run check:numeric && npm run check:i18n",
    "check:numeric": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-numeric.mjs",
    "check:i18n": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/i18n-extract.mjs --check && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/i18n-untranslated.mjs --check",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@launchpad/chat": "*",
    "@launchpad/xcp69": "*",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "@scure/base": "^2.2.0",
    "@scure/btc-signer": "^2.2.0",
    "@xcp/wallet-sdk": "github:XCP/wallet-sdk#79f190308d4b60cc3ec9023beada21e0ee776213",
    "babel-plugin-react-compiler": "^1.0.0",
    "bignumber.js": "^9.3.1",
    "next": "16.3.4",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "swr": "^2.4.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@opennextjs/cloudflare": "1.20.6",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "opencc-js": "1.4.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "4.125.0"
  }
}
